# {{ ansible_managed }}
[Unit]
Description=Scrutiny S.M.A.R.T. metrics collector
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Runs as root: smartctl needs raw access to SATA/NVMe devices.
ExecStart={{ scrutiny_collector_bin }} run --api-endpoint "{{ scrutiny_collector_api_endpoint }}"{% if scrutiny_collector_host_id | length > 0 %} --host-id "{{ scrutiny_collector_host_id }}"{% endif %}

ProtectHome=yes
PrivateTmp=yes
