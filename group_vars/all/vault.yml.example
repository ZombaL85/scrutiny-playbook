---
# Copy to vault.yml and encrypt it:
#   cp group_vars/all/vault.yml.example group_vars/all/vault.yml
#   ansible-vault encrypt group_vars/all/vault.yml
#
# On a NEW install Scrutiny onboards InfluxDB with these values on first start.
# On an EXISTING install (playbook versions before this one), InfluxDB was
# onboarded with Scrutiny's built-in defaults, so keep:
#   scrutiny_influxdb_token: "scrutiny-default-admin-token"
# or rotate the token in InfluxDB first.
scrutiny_influxdb_token: "CHANGE-ME-generate-with-openssl-rand-hex-32"
# Only needed when scrutiny_influxdb_install: true
# scrutiny_influxdb_init_password: "CHANGE-ME"

# Healthchecks project ping key (Project Settings -> Ping key),
# only needed when scrutiny_healthchecks_enabled: true
scrutiny_healthchecks_ping_key: "CHANGE-ME"
# Optional read-write project API key (Project Settings -> API Access): lets the
# playbook set each check's schedule, grace and time zone.
# scrutiny_healthchecks_api_key: "CHANGE-ME"
